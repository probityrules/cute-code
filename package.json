{
  "name": "cute-code",
  "displayName": "Cute Code",
  "description": "Visual structural AST view of JavaScript - functions, classes, calls, and returns as interconnected blocks.",
  "version": "0.3.0",
  "publisher": "GopherwoodStudios",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f6b4f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/probityrules/cute-code.git"
  },
  "bugs": {
    "url": "https://github.com/probityrules/cute-code/issues"
  },
  "homepage": "https://github.com/probityrules/cute-code#readme",
  "keywords": [
    "javascript",
    "jsx",
    "ast",
    "visualization",
    "structure",
    "graph",
    "call graph",
    "code map",
    "react flow",
    "babel"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "cuteCode.structure",
        "displayName": "Cute Code",
        "selector": [
          {
            "filenamePattern": "*.js"
          },
          {
            "filenamePattern": "*.jsx"
          },
          {
            "filenamePattern": "*.mjs"
          },
          {
            "filenamePattern": "*.cjs"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "cuteCode.openStructureView",
        "title": "Cute Code: Open Structure View",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "cuteCode.showSource",
        "title": "Cute Code: Show Source",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cuteCode.openStructureView",
          "when": "resourceScheme == file && (resourceLangId == javascript || resourceLangId == javascriptreact) && activeCustomEditorId == ''",
          "group": "navigation"
        },
        {
          "command": "cuteCode.showSource",
          "when": "activeCustomEditorId == 'cuteCode.structure'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "node --import tsx --test src/parser/extractGraph.test.ts src/parser/titleEdit.test.ts src/webview/presentation.test.ts",
    "package": "vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/babel__parser": "^7.0.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.0",
    "ovsx": "^1.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@babel/parser": "^7.23.9",
    "@babel/traverse": "^7.23.9",
    "@babel/types": "^7.23.9",
    "@dagrejs/dagre": "^1.1.2",
    "@iconify/react": "^6.0.2",
    "@iconify/types": "^2.0.0",
    "@xyflow/react": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}

